<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ADOP_Project_Part_B_Weather.Views.ForecastPage">
    <ContentPage.Content>
        <StackLayout>
            <Button Text="Refresh" Clicked="Button_Clicked" />

            <!-- Your XAML code to present the weather data in a ListView-->

            <ListView x:Name="GroupedForecast" IsGroupingEnabled="true" HasUnevenRows="true">
                <ListView.GroupHeaderTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout>
                                <Label FontSize="Title" TextColor="Cyan" Text="{Binding Key, StringFormat='{0}'}"></Label>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.GroupHeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <HorizontalStackLayout>
                                <Image Source="{Binding Icon, StringFormat='http://openweathermap.org/img/w/{0}.png'}" HorizontalOptions="FillAndExpand" WidthRequest="100" />
                                

                                <Label Margin="10"/>
                                <StackLayout>
                                    <Label Text="{Binding DateTime, StringFormat='{0:HH.mm}'}"/>
                                    <Label FontSize="25" FontAttributes="Bold" Text="{Binding Description}" />
                                    <HorizontalStackLayout>
                                        <Label FontSize="25" FontAttributes="Bold" Text="{Binding Temperature, StringFormat='Temperatur: {0} °C, '}" />
                                        <Label FontSize="25" FontAttributes="Bold" Text="{Binding WindSpeed, StringFormat='Vindhastighet: {0} m/s'}" />
                                    </HorizontalStackLayout>
                                    <Label Margin="5"/>
                                </StackLayout>
                            </HorizontalStackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>


        </StackLayout>
    </ContentPage.Content>
</ContentPage>